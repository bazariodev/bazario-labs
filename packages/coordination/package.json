{
  "name": "@bazariodev/coordination",
  "version": "1.0.0",
  "description": "Small in-process coordination primitives: FIFO storage, task executors, typed events, and backoff scheduling.",
  "license": "MIT",
  "author": "Bazario",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazariodev/bazario-labs.git",
    "directory": "packages/coordination"
  },
  "homepage": "https://github.com/Bazariodev/bazario-labs/tree/main/packages/coordination#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --lib ES2022,WebWorker"
  },
  "publishConfig": {
    "access": "public"
  }
}
