{
  "name": "bazario-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Bazario Labs — JavaScript building blocks for realtime connections, chat, and telephony, with TypeScript declarations.",
  "license": "MIT",
  "author": "Bazario",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazariodev/bazario-labs.git"
  },
  "homepage": "https://github.com/Bazariodev/bazario-labs#readme",
  "bugs": {
    "url": "https://github.com/Bazariodev/bazario-labs/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "tsc": "pnpm build && pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "health": "pnpm run tsc && pnpm run lint && pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^3.0.3",
    "rollup": "^4.64.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite>esbuild": "-",
      "source-map-js": "^1.2.2"
    }
  }
}
