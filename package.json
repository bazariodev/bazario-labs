{
  "name": "bazario-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Bazario Labs — TypeScript SDKs and tools for UCaaS (realtime, SIP, chat, telephony).",
  "license": "MIT",
  "author": "Bazario",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazariodev/bazario-labs.git"
  },
  "homepage": "https://github.com/Bazariodev/bazario-labs#readme",
  "bugs": {
    "url": "https://github.com/Bazariodev/bazario-labs/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "tsc": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "health": "pnpm run tsc && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
