{
  "name": "bazario-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Bazario Labs — TypeScript SDKs and tools for UCaaS (realtime, SIP, chat, telephony).",
  "license": "MIT",
  "author": "Bazario",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazariodev/bazario-labs.git"
  },
  "homepage": "https://github.com/Bazariodev/bazario-labs#readme",
  "bugs": {
    "url": "https://github.com/Bazariodev/bazario-labs/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
